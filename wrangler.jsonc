{
  "name": "newsdesk",
  "main": "src/index.js",
  "compatibility_date": "2026-11-24",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "newsdesk-db",
      "database_id": "PASTE_D1_DATABASE_ID_HERE"
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  }
}