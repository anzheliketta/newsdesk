
{
  "name": "newsdesk",
  "main": "src/index.js",
  "compatibility_date": "2025-11-24",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "newsdesk-db",
      "database_id": "04fc5298-f1c1-4226-aea6-e4e59fc6fcd1"
    }
  ],
  "triggers": {
    "crons": ["* * * * *"]
  }
}
